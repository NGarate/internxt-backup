{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "types": ["bun-types", "node"],
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "*": ["./node_modules/*"],
      "#src/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/test/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
